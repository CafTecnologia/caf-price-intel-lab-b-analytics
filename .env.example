APP_ENV=development
DATABASE_URL=postgresql+psycopg://procurement:procurement@postgres:5432/procurement
PRISMA_DATABASE_URL=postgresql://procurement:procurement@localhost:5432/procurement?schema=public
REDIS_URL=redis://redis:6379/0
STORAGE_ROOT=./data/storage
DEFAULT_CURRENCY=COP
DEFAULT_TRM=4200
AUTO_CREATE_SCHEMA=true
AUTH_USERS=admin:admin123:administrator,analyst:analyst123:analyst,revisor:review123:reviewer
LLM_PROVIDER=disabled
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TASK_BUDGET_USD=2.5
LLM_MAX_PROCESS_BUDGET_USD=20
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
ANTHROPIC_BASE_URL=https://api.anthropic.com
DEEPSEEK_BASE_URL=https://api.deepseek.com
BENCHMARK_IMPORT_FACTOR=0.30
BENCHMARK_CACHE_TTL_SECONDS=86400
CELERY_TASK_ALWAYS_EAGER=false
