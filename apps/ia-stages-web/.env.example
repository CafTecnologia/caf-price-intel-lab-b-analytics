# --- Simulador financiero (proceso aparte, típicamente :18030 en VPS/túnel) ---
FINANCIAL_OFFER_API_URL=http://127.0.0.1:18030

# --- Proveedores IA (Google + DeepSeek) ---
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# AI_PROVIDER=gemini
# GEMINI_MODEL=gemini-3-flash-preview
# DEEPSEEK_MODEL=deepseek-v4-flash
# AI_MODEL=gemini:gemini-3-flash-preview
# AI_PROVIDER_STAGE1=deepseek
# AI_PROVIDER_STAGE2=deepseek
# AI_PROVIDER_STAGE3=gemini
# AI_MODEL_STAGE1=deepseek-v4-flash
# AI_MODEL_STAGE2=deepseek-v4-flash
# AI_MODEL_STAGE3=gemini-2.5-flash

# URL mostrada al usuario (enlaces desde Etapa 4). Por defecto = API.
# FINANCIAL_OFFER_PUBLIC_URL=http://127.0.0.1:18030

# Origen embebido en /finanzas (iframe). Debe coincidir con donde corre `financial-offer-web`.
NEXT_PUBLIC_FINANCIAL_EMBED_ORIGIN=http://127.0.0.1:18030

# Orígenes extra de ESTA app (suite extracción) autorizados para usar iframe; deben existir también en
# frame-ancestors del Simulador. Ej.: http://127.0.0.1:3055 si ampliaste el CSP allí.
# NEXT_PUBLIC_FINANCIAL_EMBED_PARENT_ORIGINS=http://127.0.0.1:3055

# Forzar solo enlace en nueva pestaña (sin iframe), útil si el embebido falla siempre.
# NEXT_PUBLIC_FINANCIAL_EMBED_IFRAME=0

# TRM COP por USD cuando hay fuentes USD sin TRM por ítem (opcional)
# FINANCIAL_OFFER_USD_COP=4000
